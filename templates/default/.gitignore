# ==============================================================================
# AuraUI Application .gitignore
# Ignores build artifacts, temporary compiler caches, generated VFS, and IDE data
# ==============================================================================

# Build & Distribution Outputs
build/
build_dev/
dist/
out/
bin/

# Auto-Generated Virtual File System Header (generated by build)
src/vfs.h

# Compiled Binaries, Objects, and Debug Symbols
*.exe
*.dll
*.so
*.dylib
*.obj
*.o
*.lib
*.a
*.pdb
*.ilk
*.exp

# CMake Intermediate Files and Caches
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Testing/
Makefile
cmake_install.cmake
install_manifest.txt
compile_commands.json
CMakeUserPresets.json

# Visual Studio & IDE Temp Files
.vs/
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.sln
*.suo
*.user
.idea/
*.swp
*.swo

# OS Generated Files & Logs
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.log
