# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Force specific text formats
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.exe binary
*.dll binary
*.lib binary
*.so binary
*.dylib binary
*.a binary
*.zip binary
*.tar.gz binary
*.pdf binary
