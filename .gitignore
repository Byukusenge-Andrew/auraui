vendor/

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class

# IDE & Editor files
.vs/
.vscode/
*.user
*.suo
.idea/

# OS generated
.DS_Store
Thumbs.db
desktop.ini

